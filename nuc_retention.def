Bootstrap: docker
From: continuumio/miniconda3

%labels
    OWNER = Manish Yadav

%files
    /home/pol_schiessel/maya620d/pol/Projects/Codebase/NucRetention_pipeline/environment.yml /environment.yml

%post
    /opt/conda/bin/conda update -n base conda -c defaults
    /opt/conda/bin/conda env create -f /environment.yml

%runscript
    source /opt/conda/etc/profile.d/conda.sh
    conda activate nuc-retention
    exec "$@"

%environment
    export PYTHONPATH=/project
    export BASH_ENV=/opt/conda/etc/bashrc
    export PATH=/opt/conda/envs/nuc-retention/bin:$PATH